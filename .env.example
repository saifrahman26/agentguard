# AgentGuard Environment Configuration
# Copy this file to .env and fill in values
# Never commit .env to version control

# Application
APP_NAME=AgentGuard
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./agentguard.db

# Security thresholds (0-100)
REVIEW_THRESHOLD=60
BLOCK_THRESHOLD=80

# Network policy (deny | allow)
DEFAULT_NETWORK_POLICY=deny

# Optional LLM integration (leave blank to disable)
# The system works fully WITHOUT these
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Paths
POLICY_CONFIG_PATH=./policies/default_policy.json
AUDIT_LOG_PATH=./audit_logs/audit.jsonl
